---
import '../styles/fonts.css';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { asset, route } from '../lib/paths';
import { profile } from '../data/portfolio';
interface Props { title?: string; description?: string; }
const { title = `${profile.name} — Software Engineer`, description = profile.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(asset('/og.png'), Astro.site);
const structuredData = { '@context': 'https://schema.org', '@type': 'Person', name: profile.name, jobTitle: profile.title, url: new URL(route('/'), Astro.site).href, sameAs: [profile.github, profile.linkedin] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dedi Suhaimi — Thoughtful software. Built to hold up." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body id="top">
    <!-- THESIS: precision made tangible through real software. OWN-WORLD: Dedi's interface-and-system studio. STORY: work, thinking, practice, conversation. FIRST VIEWPORT: oversized type meets layered original product windows. FORM: precision studio; seed d1b3fa24. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
