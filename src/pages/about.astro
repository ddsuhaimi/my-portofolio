---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const experience = [
	{
		role: "Senior Software Engineer",
		company: "Nimbus Cloud Systems",
		period: "2022 — Now",
		description:
			"Lead a team of four building the core platform for a B2B SaaS product. Own architecture decisions for the real-time collaboration and billing subsystems.",
	},
	{
		role: "Software Engineer",
		company: "Vertex Analytics",
		period: "2019 — 2022",
		description:
			"Built data pipelines and customer-facing dashboards for a marketing analytics platform serving 200+ enterprise clients.",
	},
	{
		role: "Junior Developer",
		company: "Brightline Labs",
		period: "2017 — 2019",
		description:
			"Started as a front-end developer on an agency team, shipping websites and internal tools for clients across retail and logistics.",
	},
];

const skillGroups = [
	{ category: "Languages", items: ["TypeScript", "JavaScript", "Python", "SQL"] },
	{ category: "Frontend", items: ["React", "Next.js", "Astro", "Tailwind CSS"] },
	{ category: "Backend", items: ["Node.js", "FastAPI", "PostgreSQL", "Redis"] },
	{ category: "Infrastructure", items: ["AWS", "Docker", "GitHub Actions", "Terraform"] },
];

const education = {
	degree: "B.Sc. in Computer Science",
	school: "Institute of Technology",
	period: "2013 — 2017",
};
---

<Layout title="About" description="About Dedi — background, experience, and skills.">
	<section class="hero" style="padding-bottom: 1.5rem;">
		<div class="container">
			<span class="eyebrow">About</span>
			<h1>A little about how I work.</h1>
			<p class="lede">
				Full-stack software engineer with 7+ years of experience shipping web
				applications for startups and mid-size companies. I care most about
				clear architecture, dependable systems, and code the next engineer
				can actually understand.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHeader eyebrow="Career" heading="Experience" />
			{
				experience.map((job) => (
					<div class="experience-card">
						<div class="experience-top">
							<div>
								<p class="experience-role">{job.role}</p>
								<span class="experience-company">{job.company}</span>
							</div>
							<span class="experience-period">{job.period}</span>
						</div>
						<p style="margin:0;">{job.description}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHeader eyebrow="Toolbox" heading="Skills" />
			<div class="info-card">
				{
					skillGroups.map((group) => (
						<div class="skill-group">
							<p class="skill-group-label">{group.category}</p>
							<ul class="pill-list">
								{group.items.map((item) => (
									<li class="pill">{item}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHeader eyebrow="Background" heading="Education" />
			<div class="experience-card" style="margin-bottom:0;">
				<p class="experience-role">{education.degree}</p>
				<span class="experience-company">{education.school}</span>
				<p style="margin-top:0.75rem;">{education.period}</p>
			</div>
		</div>
	</section>
</Layout>
