---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Window from '../../components/Window.astro';
import Icon from '../../components/Icon.astro';
import Contact from '../../components/Contact.astro';
import { projects } from '../../data/projects';
import { profile } from '../../data/portfolio';
import { projectImages } from '../../data/images';
import { route } from '../../lib/paths';
export const getStaticPaths = (() => projects.map(project => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;
const { project } = Astro.props;
const images = projectImages[project.slug];
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
---
<Layout title={`${project.title} — ${profile.name}`} description={project.summary}>
  <div class="detail-page wrap">
    <a class="text-link back-link" href={route('/#work')}><Icon name="down" size={16} /> Back to selected work</a>
    <header class="detail-heading"><div class="project-meta"><span>{project.category}</span><span>{project.year}</span></div><h1>{project.title}</h1><p>{project.summary}</p><div class="detail-tags"><span>{project.role}</span>{project.tags.map(tag => <span>{tag}</span>)}</div>{project.link && <a class="button button-primary" href={project.link} target="_blank" rel="noopener noreferrer">{project.linkLabel} <Icon name="up-right" /></a>}</header>
    <div class:list={['detail-hero', `detail-${project.slug}`]}><Window image={images.hero} label={`${project.title} / Overview`} alt={`${project.title} original product interface`} priority /></div>
    <section class="detail-overview"><h2>Inside the project.</h2><div><p class="large-copy">{project.intro}</p><p>{project.closing}</p>{project.slug === 'simrs' && <p class="privacy-note">The supplied screenshots contain names and medical-record identifiers. Published images are cropped to exclude patient records and the activity feed. No patient-level information is included.</p>}</div></section>
    <section class="detail-features" aria-labelledby="features-title"><h2 id="features-title">What it brings together.</h2><div>{project.highlights?.map(highlight => <article><h3>{highlight.title}</h3><p>{highlight.text}</p></article>)}</div></section>
    <section class="detail-gallery" aria-labelledby="gallery-title"><h2 id="gallery-title">A closer look.</h2>{images.gallery.map((item) => <figure><a href={item.image.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full image: ${item.alt}`}><Image src={item.image} alt={item.alt} widths={[600, 1000, 1400]} sizes="(max-width: 700px) 92vw, 85vw" format="webp" quality={88} loading="lazy" /></a><figcaption>{item.caption}<span>Open full image <Icon name="up-right" size={14} /></span></figcaption></figure>)}</section>
    <a class="next-project" href={route(`/projects/${next.slug}/`)}><span>Next project</span><h2>{next.title}</h2><Icon name="up-right" size={44} /></a>
  </div>
  <Contact />
</Layout>
