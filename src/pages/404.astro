---
import Layout from '../layouts/Layout.astro';
import { route } from '../lib/paths';
import Icon from '../components/Icon.astro';
import { profile } from '../data/portfolio';
---
<Layout title={`Page not found — ${profile.name}`}><section class="not-found wrap"><p>404 / Page not found</p><h1>Page not found</h1><p>Try the homepage or browse my projects.</p><a class="button button-primary" href={route('/#work')}>View my work <Icon name="right" /></a></section></Layout>
