---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; label: string; priority?: boolean; class?: string; }
const { image, alt, label, priority = false, class: className = '' } = Astro.props;
---
<div class:list={['software-window', className]}>
  <div class="window-bar"><span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span><span>{label}</span><span class="window-end" aria-hidden="true"></span></div>
  <Image src={image} alt={alt} widths={[480, 800, 1200, 1400]} sizes="(max-width: 700px) 92vw, 80vw" format="webp" quality={85} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
</div>
