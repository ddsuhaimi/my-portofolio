---
import { route } from "../lib/paths";

const navItems = [
	{
		path: "/",
		label: "Home",
		icon: "M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z",
	},
	{
		path: "/about",
		label: "About",
		icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0",
	},
	{
		path: "/projects",
		label: "Projects",
		icon: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z",
	},
	{
		path: "/contact",
		label: "Contact",
		icon: "m3 6 9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z",
	},
];

const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
	path === "/" ? currentPath === route("/") : currentPath.startsWith(route(path));
---

<header class="masthead">
	<div class="container">
		<a class="masthead-brand" href={route("/")}>
			<span class="brand-mark">D</span>
			Dedi
			<span class="status-dot" aria-label="Available for work" title="Available for work"></span>
		</a>
		<button
			id="nav-toggle"
			class="nav-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Toggle menu"
		>
			<svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
				<path d="M4 7h16M4 12h16M4 17h16" />
			</svg>
			<svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
				<path d="M6 6l12 12M18 6 6 18" />
			</svg>
		</button>
		<div class="masthead-nav" id="site-nav">
			<nav aria-label="Primary">
				<ul class="nav-links">
					{
						navItems.map((item) => (
							<li>
								<a href={route(item.path)} aria-current={isActive(item.path) ? "page" : undefined}>
									<svg viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
										<path d={item.icon} />
									</svg>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById("nav-toggle");
	const nav = document.getElementById("site-nav");

	toggle?.addEventListener("click", () => {
		const expanded = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!expanded));
		nav?.classList.toggle("is-open");
	});
</script>
